---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterBand from '../components/NewsletterBand.astro';

const articles = await getCollection('articles');

const sorted = articles.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

// Groupe par année puis par mois
type Article = typeof sorted[number];
const byYear = new Map<number, Map<number, Article[]>>();

for (const a of sorted) {
  const d = new Date(a.data.publishDate);
  const y = d.getFullYear();
  const m = d.getMonth();
  if (!byYear.has(y)) byYear.set(y, new Map());
  const yMap = byYear.get(y)!;
  if (!yMap.has(m)) yMap.set(m, []);
  yMap.get(m)!.push(a);
}

const years = [...byYear.keys()].sort((a, b) => b - a);

const MONTHS_FR = [
  'Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin',
  'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre',
];

const firstDate = sorted.length ? new Date(sorted[sorted.length - 1].data.publishDate) : new Date();
const firstLabel = `${MONTHS_FR[firstDate.getMonth()].toLowerCase()} ${firstDate.getFullYear()}`;

const fmtDay = (d: Date) => String(d.getDate()).padStart(2, '0');
const domainLabel = (d?: string) =>
  d ? d.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) : '';
---

<BaseLayout
  title="Archives"
  description={`Les ${articles.length} articles du blog en vue chronologique, depuis ${firstLabel}.`}
>
  <div class="page-hero">
    <div class="orb orb-violet" style="width:500px;height:500px;top:-150px;left:-100px;opacity:0.3;"></div>
    <div class="container">
      <div class="hero-inner">
        <span class="section-label reveal">Historique</span>
        <h1 class="reveal reveal-delay-1">
          <span class="gradient-text">Archives</span><br/>
          du blog
        </h1>
        <p class="hero-sub reveal reveal-delay-2">
          {articles.length} articles publiés depuis {firstLabel}. Vue chronologique, du plus récent au plus ancien.
        </p>
      </div>
    </div>
  </div>

  <div class="container section archives-wrap">
    <!-- Jump-to-year nav -->
    <nav class="years-nav reveal" aria-label="Aller à une année">
      {years.map(y => (
        <a href={`#year-${y}`} class="year-pill">{y}</a>
      ))}
    </nav>

    {years.map(y => {
      const yMap   = byYear.get(y)!;
      const months = [...yMap.keys()].sort((a, b) => b - a);
      const total  = months.reduce((acc, m) => acc + yMap.get(m)!.length, 0);
      return (
        <section id={`year-${y}`} class="year-block reveal">
          <header class="year-header">
            <h2 class="year-title">{y}</h2>
            <span class="year-count">{total} article{total !== 1 ? 's' : ''}</span>
          </header>

          {months.map(m => {
            const items = yMap.get(m)!;
            return (
              <div class="month-block">
                <h3 class="month-title">
                  {MONTHS_FR[m]}
                  <span class="month-count">{items.length}</span>
                </h3>
                <ul class="entries">
                  {items.map(a => {
                    const d = new Date(a.data.publishDate);
                    const dom = (a.data as any).domain as string | undefined;
                    return (
                      <li class="entry">
                        <span class="entry-day" aria-hidden="true">{fmtDay(d)}</span>
                        <a class="entry-link" href={`/blog/${a.slug}/`}>
                          <span class="entry-title">{a.data.title}</span>
                          {dom && <span class="entry-domain">{domainLabel(dom)}</span>}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            );
          })}
        </section>
      );
    })}
  </div>

  <NewsletterBand />
</BaseLayout>

<style>
.page-hero {
  position: relative;
  overflow: hidden;
  padding: 7rem 0 4rem;
  border-bottom: 1px solid var(--border);
}
.hero-inner { text-align: center; position: relative; z-index: 1; }
.hero-inner h1 { font-size: clamp(2.2rem, 5vw, 4rem); line-height: 1.15; margin: 1rem 0; }
.hero-sub { color: var(--text-3); font-size: 1.05rem; max-width: 560px; margin: 0 auto; }

.archives-wrap { max-width: 880px; }

/* ── Year jump nav ── */
.years-nav {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
  margin-bottom: 3rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border);
}
.year-pill {
  font-family: var(--font-sans);
  font-size: .82rem;
  font-weight: 600;
  letter-spacing: .04em;
  padding: .4rem 1rem;
  border-radius: var(--r-full);
  border: 1px solid var(--border);
  background: var(--glass);
  color: var(--text-3);
  text-decoration: none;
  transition: all .2s;
}
.year-pill:hover {
  color: var(--violet-light);
  border-color: rgba(145, 94, 255, .35);
  background: rgba(145, 94, 255, .08);
}

/* ── Year block ── */
.year-block { margin-bottom: 3.5rem; scroll-margin-top: 6rem; }
.year-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  padding-bottom: .6rem;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid var(--border);
}
.year-title {
  font-family: var(--font-sans);
  font-size: clamp(2rem, 4vw, 2.6rem);
  font-weight: 700;
  letter-spacing: -.02em;
  margin: 0;
  color: var(--text-1);
}
.year-count {
  font-family: var(--font-mono);
  font-size: .78rem;
  color: var(--text-3);
  letter-spacing: .03em;
}

/* ── Month block ── */
.month-block { margin-bottom: 2rem; }
.month-title {
  display: flex;
  align-items: center;
  gap: .65rem;
  font-family: var(--font-sans);
  font-size: .82rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .12em;
  color: var(--text-3);
  margin: 0 0 .75rem;
}
.month-count {
  font-family: var(--font-mono);
  font-size: .72rem;
  font-weight: 500;
  color: var(--text-3);
  background: var(--glass);
  border: 1px solid var(--border);
  border-radius: var(--r-full);
  padding: .1rem .55rem;
  letter-spacing: 0;
  text-transform: none;
}

/* ── Entries ── */
.entries {
  list-style: none;
  padding: 0;
  margin: 0;
  border-top: 1px solid var(--border);
}
.entry {
  display: flex;
  align-items: baseline;
  gap: 1.25rem;
  padding: .85rem 0;
  border-bottom: 1px solid var(--border);
}
.entry-day {
  flex: 0 0 2.2rem;
  font-family: var(--font-mono);
  font-size: .82rem;
  font-weight: 500;
  color: var(--text-3);
  text-align: right;
}
.entry-link {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  text-decoration: none;
  color: var(--text-1);
  transition: color .18s;
}
.entry-link:hover            { color: var(--violet-light); }
.entry-link:hover .entry-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }

.entry-title {
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.4;
  font-weight: 500;
}
.entry-domain {
  flex: 0 0 auto;
  font-family: var(--font-mono);
  font-size: .7rem;
  color: var(--text-3);
  letter-spacing: .03em;
  white-space: nowrap;
}

@media (max-width: 640px) {
  .entry         { gap: .85rem; padding: .75rem 0; }
  .entry-day     { flex-basis: 1.8rem; font-size: .78rem; }
  .entry-link    { flex-direction: column; align-items: flex-start; gap: .25rem; }
  .entry-domain  { font-size: .68rem; }
}
</style>
